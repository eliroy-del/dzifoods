# Copy to .env.local. Never commit real secrets.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEFAULT_RESTAURANT_SLUG=dzifoods

# Supabase API — Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the new publishable + secret keys, or the legacy pair below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres for Drizzle. Connect → pooler strings.
# DATABASE_URL: transaction pooler (port 6543) for the running app
# DATABASE_URL_DIRECT: session pooler (port 5432) for migrations and seed
DATABASE_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Seeded owner (used by npm run db:seed)
SEED_OWNER_EMAIL=dzifoods@gmail.com
SEED_OWNER_NAME="DZIFOODS Admin"

# POS — generate with: openssl rand -base64 32
POS_PIN_PEPPER=
POS_TERMINAL_SECRET=

# Optional
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Later phases
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=
